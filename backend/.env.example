# Gemini
GOOGLE_API_KEY=your_google_api_key_here

# LangSmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=neurograph-ai

# Tavily
TAVILY_API_KEY=your_tavily_api_key_here

# App
APP_ENV=development
FRONTEND_URL=http://localhost:5173

# DB — leave empty for SQLite (local), set Supabase URL for prod on Render dashboard
DATABASE_URL=
SQLITE_DB_PATH=./data/neurograph.db

# RAG — Vector Store
# Leave PINECONE_API_KEY empty for local (ChromaDB auto-used), set on Render dashboard for prod
CHROMA_PATH=./data/chroma
PINECONE_API_KEY=
PINECONE_INDEX_NAME=neurograph-rag

# Auth — JWT
# Generate secret with: openssl rand -hex 32
# Never commit the real value — set on Render dashboard for prod
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080